---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · Data Science`,
  description = `${profile.name}: ${profile.role}. ${profile.pitch}`,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0d16" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      // Set theme before paint to avoid a flash. Defaults to dark.
      (() => {
        const d = document.documentElement;
        d.classList.remove('no-js');
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        d.dataset.theme = t ?? 'dark';
      })();
    </script>
  </head>
  <body class="font-sans">
    <slot />
    <script>
      // Scroll reveal
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      els.forEach((el) => io.observe(el));

      // Pointer spotlight on cards (desktop only)
      if (matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (ev) => {
            const card = (ev.target as Element | null)?.closest<HTMLElement>('.card');
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${ev.clientX - r.left}px`);
            card.style.setProperty('--my', `${ev.clientY - r.top}px`);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
