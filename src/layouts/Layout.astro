---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · Data Science`,
  description = `${profile.name}: ${profile.role}. ${profile.pitch}`,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#141311" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      // Set theme before paint to avoid a flash. Defaults to dark.
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        d.dataset.theme = t ?? 'dark';
      })();
    </script>
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
