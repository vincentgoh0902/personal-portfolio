---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.tagline}`,
  description = `${profile.summary[0]} ${profile.summary.at(-1)}`,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
// Social scrapers need an absolute URL.
const ogImage = site ? new URL('/og.png', site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3ecdf" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} · ${profile.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline>
      // Set theme before paint to avoid a flash. A saved choice wins; otherwise default to the cream light theme.
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        d.dataset.theme = t === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
