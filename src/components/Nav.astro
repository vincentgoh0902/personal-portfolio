---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4" aria-label="Main">
    <a href="#top" class="font-semibold tracking-tight">{profile.name}</a>
    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav-link rounded-md px-3 py-1.5 text-sm text-[var(--muted)] transition-colors hover:text-[var(--text)]">{l.label}</a>
          </li>
        ))}
      </ul>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-11 place-items-center rounded-md text-[var(--muted)] transition-colors hover:text-[var(--text)]"
        aria-label="Dark theme"
        aria-pressed="false"
      >
        <span class="hidden dark:block"><Icon name="sun" /></span>
        <span class="block dark:hidden"><Icon name="moon" /></span>
      </button>
    </div>
  </nav>
  <ul class="mx-auto flex max-w-5xl justify-between px-2 md:hidden">
    {links.map((l) => (
      <li>
        <a href={l.href} class="nav-link flex min-h-11 items-center px-2 text-sm text-[var(--muted)] transition-colors hover:text-[var(--text)]">{l.label}</a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const d = document.documentElement;
    toggle?.setAttribute('aria-pressed', String(d.dataset.theme === 'dark'));
    themeColor?.setAttribute('content', getComputedStyle(d).getPropertyValue('--bg').trim());
  };
  sync();
  toggle?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.dataset.theme === 'dark' ? 'light' : 'dark';
    d.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });

  // Mark the section being read: the last one whose top has passed 40% of the viewport,
  // or the final section once the page is scrolled to the bottom.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('a.nav-link')];
  const sections = [...new Set(navLinks.map((a) => a.hash))]
    .map((h) => document.querySelector<HTMLElement>(h))
    .filter((s): s is HTMLElement => s !== null);
  let queued = false;
  const markCurrent = () => {
    queued = false;
    let current = '';
    for (const s of sections) if (s.getBoundingClientRect().top <= innerHeight * 0.4) current = s.id;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections.at(-1)?.id ?? current;
    for (const a of navLinks) {
      if (a.hash === `#${current}`) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(markCurrent); }
  }, { passive: true });
  markCurrent();
</script>
