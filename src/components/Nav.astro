---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4" aria-label="Main">
    <a href="#top" class="font-semibold tracking-tight">{profile.name}</a>
    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <li>
            <a href={l.href} class="rounded-md px-3 py-1.5 text-sm text-[var(--muted)] transition-colors hover:text-[var(--text)]">{l.label}</a>
          </li>
        ))}
      </ul>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-md text-[var(--muted)] transition-colors hover:text-[var(--text)]"
        aria-label="Dark theme"
        aria-pressed="true"
      >
        <span class="hidden dark:block"><Icon name="sun" /></span>
        <span class="block dark:hidden"><Icon name="moon" /></span>
      </button>
    </div>
  </nav>
  <ul class="mx-auto flex max-w-5xl justify-between px-2 md:hidden">
    {links.map((l) => (
      <li>
        <a href={l.href} class="flex min-h-11 items-center px-2 text-sm text-[var(--muted)] transition-colors hover:text-[var(--text)]">{l.label}</a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const d = document.documentElement;
    toggle?.setAttribute('aria-pressed', String(d.dataset.theme === 'dark'));
    themeColor?.setAttribute('content', getComputedStyle(d).getPropertyValue('--bg').trim());
  };
  sync();
  toggle?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.dataset.theme === 'dark' ? 'light' : 'dark';
    d.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>
