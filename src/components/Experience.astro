---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-20">
  <SectionHeading title="Experience" subtitle="Internships building data products, LLM systems and analytics in Singapore's public and private sectors." />

  <ol class="divide-y divide-[var(--border)] border-t border-[var(--border)]">
    {experience.map((job, i) => (
      <li class="reveal grid gap-2 py-8 sm:grid-cols-[11rem_1fr] sm:gap-8" style={`--delay:${i * 80}ms`}>
        <p class="text-sm text-[var(--muted)] tabular-nums sm:pt-1">{job.period}</p>
        <article>
          <h3 class="text-lg font-semibold">
            {job.role} <span class="font-normal text-[var(--muted)]" aria-hidden="true">·</span> {job.company}
          </h3>
          <p class="mt-2">{job.summary}</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-[var(--muted)] marker:text-[var(--border)]">
            {job.points.map((p) => <li>{p}</li>)}
          </ul>
          <p class="mt-4 text-sm text-[var(--muted)]">{job.tags.join(' · ')}</p>
        </article>
      </li>
    ))}
  </ol>
</section>
