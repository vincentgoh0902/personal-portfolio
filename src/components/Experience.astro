---
import SectionHeading from './SectionHeading.astro';
import Figures from './Figures.astro';
import { experience } from '../data/site';
---

<section id="experience" class="mx-auto max-w-5xl px-4 pb-8">
  <SectionHeading title="Experience" subtitle="Internships building data products, LLM systems and analytics in Singapore's public and private sectors." />

  <ol class="divide-y divide-[var(--border)]">
    {experience.map((job) => (
      <li class="grid gap-2 py-8 first:pt-0 last:pb-0 sm:grid-cols-[14.5rem_1fr] sm:gap-8">
        <p class="font-mono text-[0.8125rem] text-[var(--muted)] sm:pt-2">{job.period}</p>
        <article class="max-w-[62ch]">
          <h3 class="text-lg font-semibold">
            {job.role} <span class="font-normal text-[var(--muted)]" aria-hidden="true">·</span> {job.company}
          </h3>
          <p class="mt-2"><Figures text={job.summary} /></p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.9375rem] leading-relaxed marker:text-[var(--muted)]">
            {job.points.map((p) => <li><Figures text={p} /></li>)}
          </ul>
          <p class="mt-4 font-mono text-[0.8125rem] text-[var(--muted)]">{job.tags.map((t, i, a) => <span class="whitespace-nowrap">{t}{i < a.length - 1 && ' ·'}</span>).reduce((acc, el) => [...acc, ' ', el], [] as any[]).slice(1)}</p>
        </article>
      </li>
    ))}
  </ol>
</section>
