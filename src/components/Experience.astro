---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-20">
  <SectionHeading index="01" title="Experience" subtitle="Internships building data products, LLM systems and analytics in Singapore's public and private sectors." />

  <ol class="relative space-y-6 border-l border-[var(--border)] pl-6 sm:pl-10">
    {experience.map((job, i) => (
      <li class="reveal relative" style={`--delay:${i * 80}ms`}>
        <span class="absolute top-7 -left-[1.95rem] size-3 rounded-full border-2 border-[var(--bg)] bg-gradient-to-br from-[var(--accent)] to-[var(--accent-2)] ring-4 ring-[var(--glow)] sm:-left-[2.95rem]" aria-hidden="true"></span>
        <article class="card card-lift p-6 sm:p-7">
          <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold">
              {job.role} <span class="text-[var(--muted)]">·</span> <span class="gradient-text">{job.company}</span>
            </h3>
            <p class="shrink-0 font-mono text-xs text-[var(--muted)]">{job.period}</p>
          </header>
          <p class="mt-3 text-[var(--text)]">{job.summary}</p>
          <ul class="mt-4 space-y-2 text-sm text-[var(--muted)]">
            {job.points.map((p) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap gap-2">
            {job.tags.map((t) => <span class="chip">{t}</span>)}
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
