---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="reveal mb-10">
  <p class="font-mono text-sm text-[var(--accent)]">{index}</p>
  <h2 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-2 max-w-2xl text-[var(--muted)]">{subtitle}</p>}
</div>
