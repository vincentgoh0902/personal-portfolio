---
// Renders a line of copy unchanged, but sets its figures (63% to 90%, 0.79 test PR-AUC, 200k, 21)
// in bold so the evidence is findable at a glance. Ignores digits inside names like Neo4j, m6A or Recall@10.
interface Props {
  text: string;
}
const { text } = Astro.props;

const num = String.raw`\d+(?:\.\d+)?(?:%|k)?`;
const figure = new RegExp(
  String.raw`(?<![\w@])${num}(?:\s+to\s+${num})?(?:\s+(?:test\s+)?(?:PR-AUC|ROC AUC))?(?![\w@])`,
  'g',
);

const parts: { text: string; figure: boolean }[] = [];
let last = 0;
for (const m of text.matchAll(figure)) {
  if (m.index! > last) parts.push({ text: text.slice(last, m.index), figure: false });
  parts.push({ text: m[0], figure: true });
  last = m.index! + m[0].length;
}
if (last < text.length) parts.push({ text: text.slice(last), figure: false });
---

{parts.map((p) => (p.figure ? <strong class="font-semibold">{p.text}</strong> : p.text))}
