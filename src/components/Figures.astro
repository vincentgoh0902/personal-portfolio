---
// Renders a line of copy unchanged, but sets its figures (63% to 90%, 39 of 40, 0.92 → 0.04, 0.79 test PR-AUC, 200k, 21)
// in bold so the evidence is findable at a glance. Ignores digits inside names like Neo4j, m6A or Recall@10.
interface Props {
  text: string;
}
const { text } = Astro.props;

const num = String.raw`\d+(?:\.\d+)?(?:%|k)?`;
// Figures written in words, which the numeric pattern can't see.
const wordFigures = String.raw`days of manual work to minutes|about three days`;
const figure = new RegExp(
  String.raw`(?<![\w@])(?:${wordFigures}|${num}(?:\s+(?:to|→|of)\s+${num})?(?:\s+(?:test\s+)?(?:PR-AUC|ROC AUC))?)(?![\w@])`,
  'g',
);

const parts: { text: string; figure: boolean; nowrap?: boolean }[] = [];
let last = 0;
for (const m of text.matchAll(figure)) {
  if (m.index! > last) parts.push({ text: text.slice(last, m.index), figure: false });
  // Numeric figures stay on one line ("0.79 PR-AUC" must not break at the hyphen); word figures may wrap.
  parts.push({ text: m[0], figure: true, nowrap: /^\d/.test(m[0]) });
  last = m.index! + m[0].length;
}
if (last < text.length) parts.push({ text: text.slice(last), figure: false });
---

{parts.map((p) => (p.figure ? <strong class:list={['font-semibold', p.nowrap && 'whitespace-nowrap']}>{p.text}</strong> : p.text))}
