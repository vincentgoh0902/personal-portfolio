---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/site';
---

<section id="education" class="mx-auto max-w-5xl px-4 pb-8">
  <SectionHeading title="Education" />

  <div class="grid gap-2 sm:grid-cols-[14.5rem_1fr] sm:gap-8">
    <p class="font-mono text-[0.8125rem] text-[var(--muted)] sm:pt-2">{education.period}</p>
    <div>
      <h3 class="text-lg font-semibold">{education.school}</h3>
      <p class="mt-1">{education.degree}</p>

      <h4 class="mt-6 font-mono text-[0.8125rem] text-[var(--muted)]">Relevant coursework</h4>
      <!-- One wrapped line, joined with " · " like the tag lines; each course stays unbroken. -->
      <ul class="mt-2 max-w-[34rem] text-[0.9375rem] leading-relaxed">
        {education.coursework.map((c, i, a) => (
          <li class="inline">
            <span class="whitespace-nowrap"><span class="font-mono text-[0.8125rem] text-[var(--muted)]">{c.code}</span> {c.name}</span>{i < a.length - 1 && <span class="text-[var(--muted)]" aria-hidden="true"> · </span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
