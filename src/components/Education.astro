---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { education } from '../data/site';
---

<section id="education" class="mx-auto max-w-5xl px-4 py-20">
  <SectionHeading index="03" title="Education" />

  <article class="card reveal p-6 sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
      <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-[var(--accent)] to-[var(--accent-2)] text-white">
        <Icon name="cap" class="size-6" />
      </span>
      <div class="flex-1">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-xl font-semibold">{education.school}</h3>
          <p class="font-mono text-xs text-[var(--muted)]">{education.period}</p>
        </div>
        <p class="mt-1 text-[var(--muted)]">{education.degree}</p>
      </div>
    </div>

    <h4 class="mt-8 mb-4 text-sm font-semibold tracking-wide text-[var(--muted)] uppercase">Relevant coursework</h4>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {education.coursework.map((c) => (
        <li class="rounded-xl border border-[var(--border)] bg-[var(--surface-2)] p-3 transition-colors hover:border-[var(--accent)]">
          <p class="font-mono text-xs text-[var(--accent)]">{c.code}</p>
          <p class="mt-0.5 text-sm">{c.name}</p>
        </li>
      ))}
    </ul>
  </article>
</section>
