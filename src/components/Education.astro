---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/site';
---

<section id="education" class="mx-auto max-w-5xl px-4 py-20">
  <SectionHeading title="Education" />

  <div class="grid gap-2 border-t border-[var(--border)] pt-8 sm:grid-cols-[11rem_1fr] sm:gap-8">
    <p class="text-sm text-[var(--muted)] tabular-nums sm:pt-1">{education.period}</p>
    <div>
      <h3 class="text-lg font-semibold">{education.school}</h3>
      <p class="mt-1 text-[var(--muted)]">{education.degree}</p>

      <h4 class="mt-8 text-sm font-semibold">Relevant coursework</h4>
      <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
        {education.coursework.map((c) => (
          <li class="flex gap-3">
            <span class="w-16 shrink-0 text-[var(--muted)] tabular-nums">{c.code}</span>
            <span>{c.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
