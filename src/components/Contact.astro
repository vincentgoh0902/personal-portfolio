---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/site';
const year = new Date().getFullYear();
---

<section id="contact" class="mx-auto max-w-5xl px-4 pb-10">
  <SectionHeading title="Let’s talk" />

  <div class="grid gap-2 sm:grid-cols-[14.5rem_1fr] sm:gap-8">
    <p class="inline-flex items-center gap-1.5 font-mono text-[0.8125rem] text-[var(--muted)] sm:items-start sm:pt-1">
      <Icon name="pin" class="size-3.5 sm:mt-[3px]" /> {profile.location}
    </p>
    <div>
      <p class="max-w-[34rem]">
        I’m graduating from NUS in May 2027 and open to data science and AI engineering roles. The fastest way to reach me is email.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">
          <Icon name="mail" /> {profile.email}
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-secondary">
          <Icon name="linkedin" /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href={profile.github} target="_blank" rel="noopener" class="btn btn-secondary">
          <Icon name="github" /> GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>

  <footer class="mt-16 font-mono text-xs text-[var(--muted)]">
    <p>© {year} {profile.name}</p>
  </footer>
</section>
