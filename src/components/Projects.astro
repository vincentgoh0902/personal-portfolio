---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Figures from './Figures.astro';
import { projects } from '../data/site';

const button =
  'inline-flex min-h-10 items-center gap-1.5 rounded-md border border-[var(--border-strong)] px-3 text-sm font-medium transition-colors hover:border-[var(--text)]';
---

<section id="projects" class="mx-auto max-w-5xl px-4 pb-8">
  <SectionHeading title="Projects" subtitle="Things I’ve built" />

  <ol class="divide-y divide-[var(--border)]">
    {projects.map((p) => (
      <li class="grid grid-cols-[46px_1fr] gap-x-4 py-10 first:pt-0 last:pb-0 sm:grid-cols-[46px_1fr_auto] sm:gap-x-6">
        <span class="grid size-[46px] place-items-center rounded-md border border-[var(--border)] text-[var(--muted)]">
          <Icon name={p.icon} class="size-6" />
        </span>
        <article class="max-w-[62ch]">
          <h3 class="pt-2 text-[1.3125rem] leading-[1.875rem] font-semibold tracking-tight">
            {p.title}
            {p.note && <span class="ml-2 align-middle font-mono text-[0.8125rem] font-normal tracking-normal whitespace-nowrap text-[var(--muted)]">{p.note}</span>}
          </h3>
          <p class="mt-2 text-lg"><Figures text={p.description} /></p>
          <p class="mt-3 font-mono text-[0.8125rem] text-[var(--muted)]">{p.tags.map((t, i, a) => <span class="whitespace-nowrap">{t}{i < a.length - 1 && ' ·'}</span>).reduce((acc, el) => [...acc, ' ', el], [] as any[]).slice(1)}</p>
        </article>
        {(p.demo || p.repo) && (
          <div class="col-start-2 mt-5 flex flex-wrap gap-2 sm:col-start-3 sm:row-start-1 sm:mt-[3px] sm:justify-end sm:self-start">
            {p.demo && (
              <a href={p.demo} target="_blank" rel="noopener" class={button}>
                <Icon name="external" /> Live demo
              </a>
            )}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener" class={button}>
                <Icon name="github" /> Code
              </a>
            )}
          </div>
        )}
      </li>
    ))}
  </ol>
</section>
