---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Figures from './Figures.astro';
import { projects } from '../data/site';
import fraudDemo from '../assets/fraud-demo.png';

const images: Record<string, ImageMetadata> = { 'fraud-demo': fraudDemo };
const bases = ['A', 'C', 'G', 'U'];
// Deterministic pseudo-random RNA strand for the m6A art, with a DRACH motif highlighted.
const strand = Array.from({ length: 72 }, (_, i) => bases[(i * 7 + (i % 5) * 3) % 4]);
const motifAt = new Set([38, 39, 40, 41, 42]);
const motif = ['G', 'G', 'A', 'C', 'U'];
motif.forEach((b, k) => (strand[38 + k] = b));
---

<section id="projects" class="mx-auto max-w-5xl px-4 pb-8">
  <SectionHeading title="Projects" subtitle="Machine learning projects with careful evaluation and reproducible results." />

  <div class="grid gap-14 md:grid-cols-2 md:gap-10">
    {projects.map((p) => (
      <article class="flex flex-col">
        <div class="relative aspect-[16/10] overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--surface)] p-2">
          {p.image && images[p.image] ? (
            <Image
              src={images[p.image]}
              alt={p.imageAlt ?? p.title}
              widths={[480, 800]}
              sizes="(min-width: 768px) 480px, 100vw"
              loading="lazy"
              class="size-full rounded-sm object-cover object-top dark:opacity-85"
            />
          ) : p.art === 'rna' ? (
            <div class="absolute inset-0 grid place-items-center p-6" aria-hidden="true">
              <div class="grid grid-cols-12 gap-1.5 font-mono text-xs sm:text-sm">
                {strand.map((b, j) => (
                  <span class={motifAt.has(j)
                    ? 'grid size-5 place-items-center rounded-sm bg-[var(--text)] text-[var(--bg)] sm:size-7'
                    : 'grid size-5 place-items-center rounded-sm text-[var(--muted)] sm:size-7'}>{b}</span>
                ))}
              </div>
              <span class="absolute right-4 bottom-3 font-mono text-xs text-[var(--muted)]">DRACH motif · m6A site</span>
            </div>
          ) : null}
        </div>

        <h3 class="mt-6 text-xl font-semibold tracking-tight">
          {p.title}
          {p.note && <span class="ml-2 align-middle font-mono text-[0.8125rem] font-normal whitespace-nowrap text-[var(--muted)]">{p.note}</span>}
        </h3>
        <p class="mt-2"><Figures text={p.blurb} /></p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.9375rem] leading-relaxed marker:text-[var(--muted)]">
          {p.points.map((pt) => <li><Figures text={pt} /></li>)}
        </ul>
        <p class="mt-4 font-mono text-[0.8125rem] text-[var(--muted)]">{p.tags.map((t, i, a) => <span class="whitespace-nowrap">{t}{i < a.length - 1 && ' ·'}</span>).reduce((acc, el) => [...acc, ' ', el], [] as any[]).slice(1)}</p>
        {(p.demo || p.repo) && (
          <div class="mt-3 flex flex-wrap gap-x-6 text-sm font-medium">
            {p.demo && (
              <a href={p.demo} target="_blank" rel="noopener" class="text-link inline-flex min-h-11 items-center gap-1.5">
                <Icon name="external" /> Live demo
              </a>
            )}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener" class="text-link inline-flex min-h-11 items-center gap-1.5">
                <Icon name="github" /> Code
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
