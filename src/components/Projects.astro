---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Figures from './Figures.astro';
import { projects } from '../data/site';
---

<section id="projects" class="mx-auto max-w-5xl px-4 pb-8">
  <SectionHeading title="Projects" />

  <ol class="divide-y divide-[var(--border)]">
    {projects.map((p) => (
      <li class="grid gap-4 py-8 first:pt-0 last:pb-0 sm:grid-cols-[14.5rem_1fr] sm:gap-8">
        <article class="max-w-[34rem] sm:col-start-2 sm:row-start-1">
          <h3 class="text-[1.3125rem] leading-[1.875rem] font-semibold tracking-tight">{p.title}</h3>
          <p class="mt-2"><Figures text={p.description} /></p>
          <p class="mt-3 font-mono text-[0.8125rem] text-[var(--muted)]">{p.tags.map((t, i, a) => <span class="whitespace-nowrap">{t}{i < a.length - 1 && ' ·'}</span>).reduce((acc, el) => [...acc, ' ', el], [] as any[]).slice(1)}</p>
        </article>
        {(p.note || p.demo || p.repo) && (
          <div class="flex flex-wrap items-center gap-2 sm:col-start-1 sm:row-start-1 sm:w-fit sm:flex-col sm:items-stretch">
            {p.note && <p class="font-mono text-[0.8125rem] text-[var(--muted)] sm:pt-1.5">{p.note}</p>}
            {p.demo && (
              <a href={p.demo} target="_blank" rel="noopener" class="btn btn-secondary px-3.5">
                <Icon name="external" /> Live demo<span class="sr-only"> of {p.title} (opens in a new tab)</span>
              </a>
            )}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener" class="btn btn-secondary px-3.5">
                <Icon name="github" /> Code<span class="sr-only"> for {p.title} (opens in a new tab)</span>
              </a>
            )}
          </div>
        )}
      </li>
    ))}
  </ol>
</section>
