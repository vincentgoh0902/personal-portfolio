---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import headshot from '../assets/headshot.jpg';
import { profile } from '../data/site';
---

<section id="top" class="pt-32 pb-8 md:pt-28">
  <div class="mx-auto max-w-5xl px-4">
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7">
      <!-- Decorative: the name is in the h1 right beside it. -->
      <Image
        src={headshot}
        alt=""
        width={112}
        height={112}
        densities={[1, 2, 3]}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="size-[88px] shrink-0 rounded-full object-cover sm:size-28"
      />
      <h1 class="text-5xl leading-[1.05] font-bold tracking-tight sm:text-7xl">{profile.name}</h1>
    </div>
    <p class="mt-5 font-mono text-[0.8125rem] text-[var(--muted)]">{profile.tagline}</p>

    <p class="mt-6 max-w-2xl text-lg">
      {profile.summary.join(' ')}
    </p>
    <p class="mt-4 max-w-2xl font-medium">{profile.availability}</p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">
        <Icon name="mail" /> {profile.email}
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-secondary">
        <Icon name="linkedin" /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a href={profile.github} target="_blank" rel="noopener" class="btn btn-secondary">
        <Icon name="github" /> GitHub<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>
