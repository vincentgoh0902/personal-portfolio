---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import headshot from '../assets/headshot.jpg';
import { profile } from '../data/site';
---

<section id="top" class="pt-36 pb-8 sm:pt-40">
  <div class="mx-auto max-w-5xl px-4">
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7">
      <Image
        src={headshot}
        alt={profile.name}
        width={112}
        height={112}
        densities={[1, 2, 3]}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="size-[88px] shrink-0 rounded-full object-cover sm:size-28"
      />
      <h1 class="text-5xl leading-[1.05] font-bold tracking-tight sm:text-7xl">{profile.name}</h1>
    </div>
    <p class="mt-5 font-mono text-[0.8125rem] text-[var(--muted)]">{profile.tagline}</p>

    <p class="mt-6 max-w-2xl text-lg">
      {profile.summary.join(' ')}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      {profile.resume && (
        <a href={profile.resume} class="inline-flex items-center gap-2 rounded-md border border-[var(--border-strong)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--text)]">
          <Icon name="file" /> Resume
        </a>
      )}
      <div class="-ml-3 flex items-center gap-1">
        <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-11 place-items-center rounded-md text-[var(--muted)] transition-colors hover:text-[var(--text)]"><Icon name="github" class="size-5" /></a>
        <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-md text-[var(--muted)] transition-colors hover:text-[var(--text)]"><Icon name="linkedin" class="size-5" /></a>
        <a href={`mailto:${profile.email}`} aria-label="Email" class="grid size-11 place-items-center rounded-md text-[var(--muted)] transition-colors hover:text-[var(--text)]"><Icon name="mail" class="size-5" /></a>
      </div>
    </div>
  </div>
</section>
