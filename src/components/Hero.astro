---
import Icon from './Icon.astro';
import { profile, highlights } from '../data/site';
---

<section id="top" class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="grid-bg absolute inset-0 opacity-60"></div>
    <div class="orb -top-32 -left-24 size-[28rem] bg-[radial-gradient(circle,var(--glow)_0%,transparent_65%)]"></div>
    <div class="orb top-10 right-[-10rem] size-[34rem] bg-[radial-gradient(circle,rgb(45_212_191/0.14)_0%,transparent_65%)]" style="animation-delay:-9s"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4">
    <p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-xs text-[var(--muted)]">
      <span class="dot-pulse size-2 rounded-full bg-emerald-500"></span>
      Data Science Intern at GovTech Singapore
    </p>

    <h1 class="reveal text-4xl font-bold tracking-tight sm:text-6xl" style="--delay:80ms">
      Hi, I'm {profile.name.split(' ')[0]}.<br />
      <span class="gradient-text">I turn data into tools people use.</span>
    </h1>

    <p class="reveal mt-6 max-w-2xl text-lg text-[var(--muted)]" style="--delay:160ms">
      {profile.role}. {profile.pitch}
    </p>

    <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--delay:240ms">
      <a href="#projects" class="group inline-flex items-center gap-2 rounded-xl bg-[var(--text)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition-transform hover:-translate-y-0.5">
        View my work
        <span class="transition-transform group-hover:translate-x-0.5"><Icon name="arrow" /></span>
      </a>
      {profile.resume && (
        <a href={profile.resume} class="inline-flex items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--accent)]">
          <Icon name="file" /> Resume
        </a>
      )}
      <div class="flex items-center gap-1 sm:ml-2">
        <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-10 place-items-center rounded-xl text-[var(--muted)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--text)]"><Icon name="github" class="size-5" /></a>
        <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-10 place-items-center rounded-xl text-[var(--muted)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--text)]"><Icon name="linkedin" class="size-5" /></a>
        <a href={`mailto:${profile.email}`} aria-label="Email" class="grid size-10 place-items-center rounded-xl text-[var(--muted)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--text)]"><Icon name="mail" class="size-5" /></a>
      </div>
    </div>

    <dl class="mt-14 grid gap-3 sm:grid-cols-3">
      {highlights.map((h, i) => (
        <div class="card reveal p-5" style={`--delay:${320 + i * 90}ms`}>
          <dt class="sr-only">{h.label}</dt>
          <dd class="font-mono text-2xl font-semibold tracking-tight gradient-text">{h.value}</dd>
          <dd class="mt-1 text-sm text-[var(--muted)]">{h.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
